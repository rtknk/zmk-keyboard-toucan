#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define ARROW 1
#define SYMBOL 2

&mt {
    flavor = "tap-preferred"; // change hold to tap
    tapping-term-ms = <250>; // 連続タップ
    quick-tap-ms = <200>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <250>;
    quick-tap-ms = <200>;
    require-prior-idle-ms = <150>;
};

/ {

    combos {
        compatible = "zmk,combos";

        bootloader {
            bindings = <&bootloader>;
            key-positions = <0 36>;
            layers = <1 2>;
        };

        BT_0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <13 36>;
            layers = <1 2>;
        };

        BT_1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <25 36>;
            layers = <1 2>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp ESCAPE  &kp Q  &kp W  &kp E  &kp R  &kp T   &kp Y  &kp U  &kp I      &kp O    &kp P      &kp BSPC
                &kp TAB     &kp A  &kp S  &kp D  &kp F  &kp G   &kp H  &kp J  &kp K      &kp L    &kp SEMI   &kp SQT
                &kp LSHFT   &kp Z  &kp X  &kp C  &kp V  &kp B   &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH  &kp LSHFT
                         &kp LCTRL  &kp LGUI  &lt 1 SPACE  &lt 2 ENTER  &kp LGUI  &kp LALT
            >;
        };

        arrow {
            display-name = "ARROW";
            bindings = <
                &trans  &none  &kp HOME        &kp UP          &kp END         &none   &none         &kp C_VOL_DN  &kp C_VOL_UP   &kp C_MUTE  &none      &kp BSPC
                &trans  &none  &kp LEFT        &kp DOWN        &kp RIGHT       &none   &kp LS(LALT)  &kp LSHFT     &kp LGUI       &kp LALT    &kp LCTRL  &none
                &trans  &none  &kp LG(LS(N3))  &kp LG(LS(N4))  &kp LG(LS(N5))  &none   &none         &kp LG(MINUS) &kp LG(EQUAL)  &none       &none      &none
                            &kp LALT        &trans          &none                     &kp LG(SPACE)      &trans         &trans
            >;
        };

        symbol {
            display-name = "SYMBOL";
            bindings = <
                &trans        &kp EXCL   &kp AT   &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS        &kp STAR   &kp LPAR  &kp RPAR  &kp DEL
                &trans        &kp N1     &kp N2   &kp N3    &kp N4    &kp N5       &kp TILDE  &kp MINUS       &kp EQUAL  &kp LBKT  &kp RBKT  &kp BACKSLASH
                &kp CAPSLOCK  &kp N6     &kp N7   &kp N8    &kp N9    &kp N0       &kp GRAVE  &kp UNDERSCORE  &kp PLUS   &kp LBRC  &kp RBRC  &kp LS(BACKSLASH)
                              &kp COMMA      &kp DOT      &kp SPACE                      &none           &trans           &trans
            >;
        };

        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
